"""gopskit is a custom toolkit centered around the Ad Noctem Collective Operations Kubernetes Cluster"""

module(
    name = "gopskit",
    repo_name = "com_github_adnoctem_gopskit",
)

bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")

# Container images - currently only the gopskit-bridge image
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "tar.bzl", version = "0.7.0")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.8")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "cat_dario_mergo",
    "com_github_go_resty_resty_v2",
    "com_github_google_go_cmp",
    "com_github_hashicorp_hcl_v2",
    "com_github_hashicorp_vault_client_go",
    "com_github_luzifer_go_dhparam",
    "com_github_moby_term",
    "com_github_nerzal_gocloak_v14",
    "com_github_olekukonko_tablewriter",
    "com_github_spf13_cobra",
    "com_github_spf13_pflag",
    "com_github_stretchr_testify",
    "com_github_testcontainers_testcontainers_go",
    "com_github_testcontainers_testcontainers_go_modules_k3s",
    "com_github_testcontainers_testcontainers_go_modules_vault",
    "com_github_vmware_labs_yaml_jsonpath",
    "in_gopkg_yaml_v3",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_cli_runtime",
    "io_k8s_client_go",
    "io_k8s_streaming",
    "io_k8s_utils",
    "org_golang_x_crypto",
    "org_golang_x_mod",
    "org_golang_x_text",
    "org_uber_go_zap",
    "sh_helm_helm_v3",
    "sm_step_go_crypto",
)

# DO NOT REMOVE! Cannot build with Resty without this
# ref: https://github.com/bazelbuild/bazel-gazelle/issues/1885
go_deps.gazelle_override(
    path = "github.com/go-resty/resty/v2",
)
