load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "socks5",
    srcs = ["server.go"],
    importpath = "github.com/adnoctem/gopskit/pkg/bridge/socks5",
    visibility = ["//visibility:public"],
    deps = ["//pkg/log"],
)

alias(
    name = "go_default_library",
    actual = ":socks5",
    visibility = ["//visibility:public"],
)

go_test(
    name = "socks5_test",
    srcs = ["server_test.go"],
    embed = [":socks5"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
