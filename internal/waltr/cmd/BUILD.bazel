load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cmd",
    srcs = [
        "cmd.go",
        "connect.go",
        "init.go",
        "state.go",
    ],
    importpath = "github.com/adnoctem/gopskit/internal/waltr/cmd",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/bridgecmd",
        "//internal/waltr/app",
        "//internal/waltr/state",
        "//internal/waltr/util",
        "//pkg/api/vault",
        "//pkg/config",
        "//pkg/core",
        "//pkg/tools",
        "@com_github_hashicorp_hcl_v2//gohcl",
        "@com_github_hashicorp_hcl_v2//hclparse",
        "@com_github_hashicorp_vault_client_go//schema",
        "@com_github_spf13_cobra//:cobra",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)

alias(
    name = "go_default_library",
    actual = ":cmd",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "cmd_test",
    # the command tests run Vault in containers, skipping themselves when there is no Docker daemon
    size = "large",
    srcs = ["cmd_test.go"],
    data = ["//cmd/waltr:waltr.example.yaml"],
    embed = [":cmd"],
    tags = ["requires-network"],
    deps = [
        "//internal/waltr/app",
        "//internal/waltr/util",
        "//pkg/api/vault",
        "//pkg/api/vault/vaulttest",
        "//pkg/core",
        "//pkg/kube",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//kubernetes/fake",
    ],
)
