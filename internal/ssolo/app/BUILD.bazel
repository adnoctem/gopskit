load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "app",
    srcs = ["app.go"],
    importpath = "github.com/adnoctem/gopskit/internal/ssolo/app",
    visibility = ["//:__subpackages__"],
    deps = [
        "//pkg/api/keycloak",
        "//pkg/core",
        "//pkg/fsi",
        "//pkg/kube",
        "//pkg/log",
        "//pkg/proc",
        "//pkg/stamp",
        "@com_github_spf13_cobra//:cobra",
    ],
)

alias(
    name = "go_default_library",
    actual = ":app",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "app_test",
    srcs = ["app_test.go"],
    embed = [":app"],
    deps = ["@com_github_stretchr_testify//assert"],
)
