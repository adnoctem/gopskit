load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "carto_lib",
    srcs = ["main.go"],
    importpath = "github.com/fmjstudios/gopskit/cmd/carto",
    visibility = ["//visibility:private"],
    deps = [
